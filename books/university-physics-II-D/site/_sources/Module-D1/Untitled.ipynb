   "source": [
    "import numpy as np\n",
    "\n",
    "k = 8.99e9\n",
    "q1 = 5.0e-3\n",
    "q2 = 2.0e-3\n",
    "\n",
    "r1 = np.array([2.0, 3.0, 0.0])\n",
    "r2 = np.array([3.0, 1.5, 0.0])\n",
    "\n",
    "r = r2 - r1\n",
    "r_mag = np.linalg.norm(r)\n",
    "\n",
    "F = k*q1*q2 * r / (r_mag**3)\n",
    "F"
   ]

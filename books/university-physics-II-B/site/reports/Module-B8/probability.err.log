delta_x = np.sqrt(x2_mean - x_mean**2)

print(f"Normalization ≈ {normalization:.5f}")
print(f"<x> ≈ {x_mean:.5f}")
print(f"Δx ≈ {delta_x:.5f} (should ≈ σ_x = {sigma_x})")

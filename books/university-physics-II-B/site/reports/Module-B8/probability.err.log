# Numerical check for Gaussian normalization & expectation values
import numpy as np

x = np.linspace(-10,10,5000)
sigma_x = 1.0

psi = (1/(2*np.pi*sigma_x**2)**0.25) * np.exp(-x**2/(4*sigma_x**2))
prob = np.abs(psi)**2


import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

# Define the function
def f(x, y):
    return np.exp(-y**2) * np.sin(x)

# Create grid
x = np.linspace(-2*np.pi, 2*np.pi, 200)
y = np.linspace(-3, 3, 200)
X, Y = np.meshgrid(x, y)
Z = f(X, Y)

# Plot
fig = plt.figure(figsize=(10, 7))
ax = fig.add_subplot(111, projection='3d')

# Main surface
ax.plot_surface(X, Y, Z, cmap='viridis', alpha=0.8, edgecolor='none')

# Projections on planes
ax.contour(X, Y, Z, zdir='z', offset=np.min(Z)-0.5, cmap='viridis')  # xy-plane projection
ax.contour(X, Y, Z, zdir='y', offset=np.max(y)+0.5, cmap='viridis')  # xz-plane projection
ax.contour(X, Y, Z, zdir='x', offset=np.min(x)-0.5, cmap='viridis')  # yz-plane projection

# Labels
ax.set_xlabel('x', labelpad=10)
ax.set_ylabel('y', labelpad=10)
ax.zaxis.label.set_text(r'$f(x,y)$')  # Force z-label to display
ax.zaxis.labelpad = 1.5  # Adjust distance from axis if needed

# Title
ax.set_title(r'$f(x,y)=e^{-y^2}\sin(x)$ with Projections', pad=20)

# Adjust viewing angle for clarity
ax.view_init(elev=25, azim=-60)

plt.show()

